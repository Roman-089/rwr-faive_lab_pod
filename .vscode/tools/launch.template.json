    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Train orca-v2-inhand-repose-v0 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "args" : ["--task", "orca-v2-inhand-repose-v0", "--num_envs", "4096", "--headless", "--video", "--video_interval", "4000"],
            "program": "${workspaceFolder}/scripts/rsl_rl/train.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Play orca-v2-inhand-repose-v0 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "args" : ["--task", "orca-v2-inhand-repose-v0", "--num_envs", "32"],
            "program": "${workspaceFolder}/scripts/rsl_rl/play.py",
            "console": "integratedTerminal",
        },
    ]
}
